#!/bin/bash

set -euo pipefail

WALLPAPER=$(readlink -f "$HOME/.config/omarchy/current/background" 2>/dev/null)
BORDER_CONF="$HOME/.config/hypr/border-colors.conf"
COLORS_TOML="$HOME/.config/omarchy/current/theme/colors.toml"

if [[ ! -f $WALLPAPER ]]; then
  notify-send "border-from-wallpaper" "No wallpaper found" -t 3000
  exit 1
fi

HEX=$(magick "$WALLPAPER" -resize 1x1 -format "%[hex:u.p{0,0}]" info:- 2>/dev/null)
if [[ -z $HEX ]]; then
  notify-send "border-from-wallpaper" "Failed to extract color from wallpaper" -t 3000
  exit 1
fi

R=$((16#${HEX:0:2}))
G=$((16#${HEX:2:2}))
B=$((16#${HEX:4:2}))

# Check if the extracted color has enough chroma (colorfulness)
max=$R; min=$R
[[ $G -gt $max ]] && max=$G; [[ $B -gt $max ]] && max=$B
[[ $G -lt $min ]] && min=$G; [[ $B -lt $min ]] && min=$B
range=$(( max - min ))
lightness=$(( (max + min) / 2 ))

# Use theme accent as fallback when wallpaper is grayscale or too dark
if (( range < 20 || lightness < 30 )); then
  FALLBACK=$(grep -oP '(?<=^accent = ")#[0-9a-fA-F]{6}(?=")' "$COLORS_TOML" 2>/dev/null || echo "")
  if [[ -n $FALLBACK ]]; then
    HEX="${FALLBACK:1}"
    R=$((16#${HEX:0:2}))
    G=$((16#${HEX:2:2}))
    B=$((16#${HEX:4:2}))
  fi
fi

# Ensure minimum lightness (35) for visible active border
max=$R; min=$R
[[ $G -gt $max ]] && max=$G; [[ $B -gt $max ]] && max=$B
[[ $G -lt $min ]] && min=$G; [[ $B -lt $min ]] && min=$B
lightness=$(( (max + min) / 2 ))
if (( lightness < 35 )); then
  scale=$(( (35 * 255) / (lightness + 1) ))
  R=$(( R * scale / 255 ))
  G=$(( G * scale / 255 ))
  B=$(( B * scale / 255 ))
  [[ $R -gt 255 ]] && R=255
  [[ $G -gt 255 ]] && G=255
  [[ $B -gt 255 ]] && B=255
fi

# Dim for inactive border (40% brightness)
RI=$(( R * 40 / 100 ))
GI=$(( G * 40 / 100 ))
BI=$(( B * 40 / 100 ))

ACTIVE=$(printf "rgb(%02x%02x%02x)" $R $G $B)
INACTIVE=$(printf "rgb(%02x%02x%02x)" $RI $GI $BI)

cat > "$BORDER_CONF" <<EOF
\$activeBorderColor = ${ACTIVE}
\$inactiveBorderColor = ${INACTIVE}
EOF

# Write accent color for Waybar modules
HEX_FULL=$(printf "%02x%02x%02x" $R $G $B)
cat > "$HOME/.config/waybar/dynamic.css" <<EOF
@define-color accent #${HEX_FULL};
EOF

hyprctl reload 2>/dev/null || true
if pgrep -x waybar >/dev/null; then
  omarchy-restart-waybar
fi
notify-send "border-from-wallpaper" "Borders: active=${ACTIVE}" -t 2000

#!/bin/bash
# Tracks actual screen-on time since last charger unplug.
# Screen events arrive via named pipe from omarchy-brightness-display and systemd sleep hooks.
# Battery state is polled every 10s (cheap sysfs read, no process spawning).
#
# State file: $HOME/.local/state/omarchy/sot.state
# Format: <unplug_ts> <accumulated_seconds> <screen_on_since>
#   unplug_ts       = 0 while charging; unix ts of last unplug otherwise
#   accumulated     = total screen-on seconds banked when screen went off
#   screen_on_since = 0 if screen is currently off; unix ts it turned on otherwise

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/sot.state"
PIPE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/sot.pipe"
mkdir -p "$(dirname "$STATE_FILE")"

[[ -p "$PIPE" ]] || mkfifo "$PIPE"

BAT_PATH=$(find /sys/class/power_supply -maxdepth 1 -name "BAT*" | head -1)
BAT_MODEL=$(cat "$BAT_PATH/model_name" 2>/dev/null)
UPOWER_HIST=$(find /var/lib/upower -name "history-charge-${BAT_MODEL}*.dat" 2>/dev/null | head -1)

get_bat_status() { cat "$BAT_PATH/status" 2>/dev/null; }

read_state() {
    if [[ -f "$STATE_FILE" ]]; then
        read -r _unplug _accum _screen_since < "$STATE_FILE"
    else
        _unplug=0; _accum=0; _screen_since=0
    fi
}

write_state() {
    printf '%s %s %s\n' "$1" "$2" "$3" > "${STATE_FILE}.tmp"
    mv "${STATE_FILE}.tmp" "$STATE_FILE"
}

get_last_unplug_ts() {
    [[ -f "$UPOWER_HIST" ]] || { echo 0; return; }
    awk '
        prev != "" && prev != "discharging" && $3 == "discharging" { last = $1 }
        { prev = $3 }
        END { print last + 0 }
    ' "$UPOWER_HIST"
}

on_screen_off() {
    local now=$1
    read_state
    [[ $_screen_since -eq 0 ]] && return
    write_state "$_unplug" "$((_accum + now - _screen_since))" 0
}

on_screen_on() {
    local now=$1
    read_state
    [[ $_screen_since -gt 0 ]] && return
    write_state "$_unplug" "$_accum" "$now"
}

check_battery() {
    local now=$1
    local bat_status
    bat_status=$(get_bat_status)
    read_state

    if [[ "$bat_status" != "Discharging" ]]; then
        [[ $_unplug -ne 0 ]] && write_state 0 0 0
    elif [[ $_unplug -eq 0 ]]; then
        local last_unplug
        last_unplug=$(get_last_unplug_ts)
        [[ $last_unplug -eq 0 ]] && last_unplug=$now
        write_state "$last_unplug" 0 0
    fi
}

# Bank current screen-on time when daemon stops (shutdown / service restart)
trap 'on_screen_off "$(date +%s)"' EXIT

# Open pipe for reading; keep write end open on fd 3 so reads block instead of returning EOF
exec 3<>"$PIPE"

# Initialize battery state, then detect current screen state once via hyprctl
check_battery "$(date +%s)"
read_state
if [[ $_unplug -ne 0 && $_screen_since -eq 0 ]]; then
    hyprctl monitors -j 2>/dev/null | grep -q '"dpmsStatus": true' && \
        write_state "$_unplug" "$_accum" "$(date +%s)"
fi

# Main loop: block on pipe events, poll battery every 10s via read timeout
while true; do
    if IFS= read -r -u 3 -t 10 event; then
        now=$(date +%s)
        case "$event" in
            screen-off|sleep) on_screen_off "$now" ;;
            screen-on|wake)   on_screen_on  "$now" ;;
        esac
    else
        check_battery "$(date +%s)"
    fi
done

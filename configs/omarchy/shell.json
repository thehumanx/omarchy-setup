{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "format": "MMM d, ddd HH:mm",
          "id": "bbk.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "bbk.weather"
        },
        {
          "id": "bbk.system-update"
        }
      ],
      "left": [
        {
          "id": "bbk.workspaces"
        }
      ],
      "right": [
        {
          "id": "bbk.tray"
        },
        {
          "id": "bbk.agents"
        },
        {
          "id": "bbk.bluetooth"
        },
        {
          "id": "bbk.audio"
        },
        {
          "id": "bbk.network"
        },
        {
          "id": "bbk.memory"
        },
        {
          "id": "bbk.monitor"
        },
        {
          "id": "bbk.power",
          "showPercentage": true
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "bbk.lock"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "bbk.lock"
  ]
}

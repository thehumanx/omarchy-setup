#!/bin/bash
# Generate a color theme from a wallpaper and apply it as a dedicated,
# self-contained Omarchy theme ("from-wallpaper"). Never touches any other
# theme; only this theme's own directory is created/overwritten.

set -uo pipefail

WALLPAPER="$1"
THEME_NAME="from-wallpaper"
THEME_DIR="$HOME/.config/omarchy/themes/$THEME_NAME"

if [[ ! -f "$WALLPAPER" ]]; then
  echo "File not found: $WALLPAPER" >&2
  exit 1
fi

rm -rf "$THEME_DIR"
mkdir -p "$THEME_DIR"

# --no-apply: only render the theme files, don't let aether touch any
# app configs directly. --no-zed/--no-vscode/--no-neovim: skip aether's own
# per-editor integrations since `omarchy theme set` already syncs supported
# editors through Omarchy's own commands, and running both would double-write
# conflicting config files.
aether --generate "$WALLPAPER" --output "$THEME_DIR" --no-apply --no-zed --no-vscode --no-neovim

# Bar widgets sit over the top strip of the wallpaper with no solid backing,
# so on a dark-topped wallpaper the theme's normal foreground can end up
# low-contrast (e.g. muted/inactive workspace numbers near-invisible). If the
# sampled top strip is dark, ship a `shell.bar.toml` section override next to
# the generated theme: omarchy-theme-set-templates merges just the [bar]
# section on top of the template-generated shell.toml, leaving every other
# surface (popups, menu, controls, ...) on its normal theme-derived colors.
python3 - "$WALLPAPER" "$THEME_DIR/colors.toml" "$THEME_DIR/shell.bar.toml" <<'PYEOF' || true
import colorsys
import re
import subprocess
import sys

wallpaper, colors_path, override_path = sys.argv[1:4]

# Average color of the top strip of the wallpaper, roughly where the bar sits.
out = subprocess.run(
    ["magick", wallpaper, "-gravity", "North", "-crop", "100%x6%+0+0",
     "+repage", "-resize", "1x1", "txt:-"],
    capture_output=True, text=True, check=True,
).stdout
m = re.search(r"#([0-9A-Fa-f]{6})", out)
r, g, b = (int(m.group(1)[i:i + 2], 16) for i in (0, 2, 4))
luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b

THRESHOLD = 90  # 0-255; below this the wallpaper's top strip reads as "dark"
if luminance >= THRESHOLD:
    sys.exit(0)

def relight(hex_color, target_l):
    r, g, b = (int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
    nr, ng, nb = (round(c * 255) for c in colorsys.hls_to_rgb(h, target_l, s))
    return "#{:02X}{:02X}{:02X}".format(nr, ng, nb)

with open(colors_path) as f:
    colors_text = f.read()

def color_key(name, fallback):
    m = re.search(rf'^{name}\s*=\s*"(#[0-9A-Fa-f]{{6}})"', colors_text, re.M)
    return m.group(1) if m else fallback

# Lighten the theme's own foreground for bar text, rather than jumping to
# plain white, so text keeps the theme's hue.
text = relight(color_key("foreground", "#ffffff"), 0.85)

# Widget pills (CustomPill.qml) fill with bar.background at ~55% opacity.
# The theme's raw background is near-black, so on a dark wallpaper the pill
# optically disappears into it. Mid-tone it (using the background's own hue)
# so pills read as visible chips, while staying darker than the lightened
# text above for contrast between the two.
background = relight(color_key("background", "#000000"), 0.16)

with open(override_path, "w") as f:
    f.write(
        "# Auto-written by wallpaper-to-theme: the wallpaper's top strip is dark,\n"
        "# so bar widget text and pill backgrounds are relit for contrast.\n"
        "[bar]\n"
        f'text = "{text}"\n'
        f'background = "{background}"\n'
        # CustomPill.qml fills at a fixed 55% alpha on top of this; scaling
        # this down nets a much subtler tint overall.
        'background-alpha = 0.15\n'
    )
PYEOF

omarchy theme set "$THEME_NAME"

notify-send "Theme" "Colors generated from wallpaper" -t 2000

#!/bin/bash

# Post-update hook to restore customizations after Omarchy updates.
# Installed via: omarchy hook install post-update <this-file>
#
# Every restore diffs the live file against the repo copy FIRST and prints
# a DRIFT warning if they differ, before overwriting — so an update that
# changed something gets flagged instead of silently clobbered.

set -uo pipefail

SETUP_DIR="$HOME/omarchy-configs"
CONFIG_DIR="$HOME/.config"

echo "--- Restoring customizations after Omarchy update ---"

restore_config() {
  local src="$1" dst="$2"
  [[ -f "$src" ]] || return
  if [[ -f "$dst" ]] && ! cmp -s "$src" "$dst"; then
    echo "  WARNING DRIFT: $dst changed since last sync — overwriting with repo version."
    echo "      review: diff \"$dst\" \"$src\""
  fi
  mkdir -p "$(dirname "$dst")"
  cp "$src" "$dst"
  echo "  Restored: $dst"
}

restore_dir() {
  local src="$1" dst="$2"
  [[ -d "$src" ]] || return
  mkdir -p "$dst"
  cp -r "$src"/* "$dst/" 2>/dev/null || true
  echo "  Restored: $dst/"
}

restore_tree() {
  local src="$1" dst="$2"
  [[ -d "$src" ]] || return
  if [[ -d "$dst" ]]; then
    local diffs
    diffs=$(diff -rq "$dst" "$src" 2>/dev/null | grep -v "^Only in $src" || true)
    if [[ -n "$diffs" ]]; then
      echo "  WARNING DRIFT under $dst (differs from repo before restore):"
      echo "$diffs" | sed 's/^/      /'
    fi
  fi
  mkdir -p "$dst"
  rsync -a --delete "$src"/ "$dst"/
  echo "  Restored: $dst/"
}

# ── Hyprland ──────────────────────────────────────────────────────────
echo "== Hyprland (Lua) =="
for f in "$SETUP_DIR/configs/hypr/"*.lua; do
  restore_config "$f" "$CONFIG_DIR/hypr/$(basename "$f")"
done

# ── Custom bar ────────────────────────────────────────────────────────
echo "== Custom bar =="
restore_config "$SETUP_DIR/configs/bar/shell.json"   "$CONFIG_DIR/omarchy/shell.json"
restore_config "$SETUP_DIR/configs/bar/shell.toml"   "$CONFIG_DIR/omarchy/shell.toml"
restore_tree   "$SETUP_DIR/configs/bar/plugins"      "$CONFIG_DIR/omarchy/plugins"

# ── Lock screen (inject into shell.json) ──────────────────────────────
echo "== Lock screen =="
if [[ -d "$SETUP_DIR/configs/bar/plugins/custom.lock" ]]; then
  if [[ -f "$CONFIG_DIR/omarchy/shell.json" ]] && command -v python3 &>/dev/null; then
    python3 "$SETUP_DIR/install/lock-inject.py" "$CONFIG_DIR/omarchy/shell.json"
  fi
fi

# ── Wallpaper pipeline ────────────────────────────────────────────────
echo "== Wallpaper pipeline =="
restore_config "$SETUP_DIR/configs/wallpaper/wallpaper-portal.py"  "$CONFIG_DIR/omarchy/wallpaper-portal.py"
restore_config "$SETUP_DIR/configs/wallpaper/wallpaper-to-theme"   "$CONFIG_DIR/omarchy/wallpaper-to-theme"
restore_config "$SETUP_DIR/configs/portal/omarchy.portal"          "$HOME/.local/share/xdg-desktop-portal/portals/omarchy.portal"
restore_config "$SETUP_DIR/configs/portal/hyprland-portals.conf"   "$CONFIG_DIR/xdg-desktop-portal/hyprland-portals.conf"

# ── Cursor ────────────────────────────────────────────────────────────
echo "== Cursor theme =="
restore_tree "$SETUP_DIR/configs/cursor/Afterglow-cursors" "$HOME/.local/share/icons/Afterglow-cursors"
if command -v gsettings &>/dev/null; then
  gsettings set org.gnome.desktop.interface cursor-theme "Afterglow-cursors" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface cursor-size 24 2>/dev/null || true
fi
if command -v hyprctl &>/dev/null; then
  hyprctl setcursor "Afterglow-cursors" 24 2>/dev/null || true
fi

# ── Bin overrides ─────────────────────────────────────────────────────
echo "== Bin overrides =="
for f in "$SETUP_DIR/configs/bin/"*; do
  [[ -f "$f" ]] || continue
  restore_config "$f" "$HOME/.local/share/omarchy/bin/$(basename "$f")"
done

# ── Branding ──────────────────────────────────────────────────────────
echo "== Branding =="
if [[ -f "$SETUP_DIR/configs/branding/about.txt" ]]; then
  restore_config "$SETUP_DIR/configs/branding/about.txt" "$CONFIG_DIR/omarchy/branding/about.txt"
fi
if [[ -f "$SETUP_DIR/configs/branding/screensaver.txt" ]]; then
  restore_config "$SETUP_DIR/configs/branding/screensaver.txt" "$CONFIG_DIR/omarchy/branding/screensaver.txt"
fi

# ── Ensure scripts are executable ─────────────────────────────────────
chmod +x "$CONFIG_DIR/omarchy/wallpaper-to-theme" 2>/dev/null || true

echo "--- Customizations restored ---"
echo "If any DRIFT warnings printed above, review them — Omarchy's update may"
echo "have changed something worth folding into this repo."
